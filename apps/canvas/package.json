{
  "name": "@unimatrix/canvas-app",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic Canvas HTTP and MCP caller proof.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "node ../../infra/scripts/run-local-workload.mjs -- tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "node ../../infra/scripts/run-local-workload.mjs -- eslint .",
    "test": "node ../../infra/scripts/run-local-workload.mjs -- node --import tsx --test test/**/*.test.ts",
    "typecheck": "node ../../infra/scripts/run-local-workload.mjs -- tsc -p tsconfig.json"
  },
  "dependencies": {
    "@unimatrix/auth": "workspace:*",
    "@unimatrix/mcp": "workspace:*",
    "@unimatrix/service-http": "workspace:*",
    "@unimatrix/shared": "workspace:*",
    "fastify": "^5.12.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
