{
  "name": "@unimatrix/poker-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local Poker Assistant with native screenshot capture and game-state reading.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../infra/scripts/run-local-workload.mjs -- vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:x11": "WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 GDK_BACKEND=x11 tauri dev",
    "lint": "node ../../infra/scripts/run-local-workload.mjs -- eslint .",
    "typecheck": "node ../../infra/scripts/run-local-workload.mjs -- tsc -p tsconfig.json",
    "test": "node ../../infra/scripts/run-local-workload.mjs -- sh -c 'pnpm run test:unit && pnpm run test:smoke'",
    "test:unit": "node ../../infra/scripts/run-local-workload.mjs -- vitest run",
    "test:smoke": "node ../../infra/scripts/run-local-workload.mjs -- playwright test"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-router": "^1.170.29",
    "@tauri-apps/api": "^2.10.1",
    "@unimatrix/chrome": "workspace:^",
    "@unimatrix/poker": "workspace:*",
    "@unimatrix/shared": "workspace:*",
    "@unimatrix/ui": "workspace:^",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "lucide-react": "^1.14.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/config-vitest": "workspace:*",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.4",
    "vitest": "^5.0.1"
  }
}
