{
  "extends": "@unimatrix/config-typescript/vite-app.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@unimatrix/app-config": ["../../packages/app-config/src/index.ts"],
      "@unimatrix/api-client": ["../../packages/api-client/src/index.ts"],
      "@unimatrix/deploy-config": ["../../packages/deploy-config/src/index.ts"],
      "@unimatrix/chrome/tool": ["../../packages/chrome/src/tool.ts"],
      "@unimatrix/shared": ["../../packages/shared/src/index.ts"],
      "@unimatrix/ui/scroll-area": ["../../packages/ui/src/components/ui/scroll-area.tsx"],
      "@unimatrix/ui/public": ["../../packages/ui/src/public.ts"],
      "@unimatrix/ui": ["../../packages/ui/src/index.ts"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "deploy.config.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
