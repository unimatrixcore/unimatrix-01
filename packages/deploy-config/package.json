{
  "name": "@unimatrix/deploy-config",
  "version": "0.1.0",
  "private": true,
  "description": "Typed per-app deploy config the Dockerfile/compose generator reads instead of hand-edited deploy artifacts.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "node ../../infra/scripts/run-local-workload.mjs -- eslint .",
    "test": "node ../../infra/scripts/run-local-workload.mjs -- vitest run",
    "typecheck": "node ../../infra/scripts/run-local-workload.mjs -- tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/config-vitest": "workspace:*",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
