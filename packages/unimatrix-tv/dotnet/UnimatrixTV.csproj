<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UnimatrixTV</AssemblyName>
    <RootNamespace>UnimatrixTV</RootNamespace>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="MediaBrowser.Model">
      <HintPath>./refs/MediaBrowser.Model.dll</HintPath>
    </Reference>
    <Reference Include="MediaBrowser.Common">
      <HintPath>./refs/MediaBrowser.Common.dll</HintPath>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>./refs/MediaBrowser.Controller.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\configPage.html" />
    <EmbeddedResource Include="..\dist\presentation.css" Link="Resources\presentation.css" />
    <EmbeddedResource Include="..\dist\unimatrix.js" Link="Resources\unimatrix.js" />
    <EmbeddedResource Include="..\dist\assets\**\*" Link="Resources\assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
