{
  "name": "@unimatrix/tv",
  "version": "0.1.0",
  "private": true,
  "description": "Unimatrix-TV presentation plugin and client adapter.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build:client": "node ../../infra/scripts/run-local-workload.mjs -- node ./scripts/build-client.mjs",
    "build:plugin": "node ../../infra/scripts/run-local-workload.mjs -- dotnet build ./dotnet/UnimatrixTV.csproj -c Release",
    "build:requests": "node ../../infra/scripts/run-local-workload.mjs -- node ./scripts/build-requests.mjs",
    "package": "node ./scripts/package-plugin.mjs",
    "build": "node ../../infra/scripts/run-local-workload.mjs -- sh -c 'pnpm build:client && pnpm build:plugin && pnpm build:requests && pnpm package \"$@\"' --",
    "deploy:live": "node ./scripts/deploy.mjs",
    "lint": "node ../../infra/scripts/run-local-workload.mjs -- eslint .",
    "test": "node ../../infra/scripts/run-local-workload.mjs -- sh -c 'vitest run && pnpm test:requests && pnpm test:plugin && pnpm test:deployment && pnpm test:automation \"$@\"' --",
    "typecheck": "node ../../infra/scripts/run-local-workload.mjs -- tsc -p tsconfig.json",
    "test:requests": "node ../../infra/scripts/run-local-workload.mjs -- node requests/run-tests.cjs",
    "test:plugin": "node ../../infra/scripts/run-local-workload.mjs -- node scripts/test-plugin.mjs",
    "test:deployment": "node ../../infra/scripts/run-local-workload.mjs -- node --test scripts/deploy.test.mjs",
    "test:automation": "node ../../infra/scripts/run-local-workload.mjs -- python3 -B -m unittest discover -s automation -p 'test_*.py'"
  },
  "devDependencies": {
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/config-vitest": "workspace:*",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
