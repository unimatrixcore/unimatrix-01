{
  "name": "@unimatrix/tv",
  "version": "0.1.0",
  "private": true,
  "description": "Unimatrix-TV presentation plugin and client adapter.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build:client": "node ./scripts/build-client.mjs",
    "build:plugin": "dotnet build ./dotnet/UnimatrixTV.csproj -c Release",
    "build:requests": "node ./scripts/build-requests.mjs",
    "package": "node ./scripts/package-plugin.mjs",
    "build": "pnpm build:client && pnpm build:plugin && pnpm build:requests && pnpm package",
    "deploy:live": "node ./scripts/deploy.mjs",
    "lint": "eslint .",
    "test": "vitest run && pnpm test:requests && pnpm test:plugin",
    "typecheck": "tsc -p tsconfig.json",
    "test:requests": "node requests/run-tests.cjs",
    "test:plugin": "node scripts/test-plugin.mjs"
  },
  "devDependencies": {
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/config-vitest": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
