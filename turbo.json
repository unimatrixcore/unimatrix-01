{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".node-version", ".npmrc", "pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NODE_ENV", "VITE_*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@unimatrix/tv#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "UNIMATRIX_LOCAL_WORKLOAD",
    "UNIMATRIX_CONTAINER_BUILD",
    "GITHUB_ACTIONS",
    "RUNNER_ENVIRONMENT"
  ]
}
