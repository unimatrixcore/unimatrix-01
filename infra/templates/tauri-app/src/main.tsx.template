import { StrictMode } from "react";
import { createRoot } from "react-dom/client";
import { QueryClientProvider } from "@tanstack/react-query";
import { configureListMemoryProvider, createInstantQueryClient } from "@unimatrix/instant-list";
import { client, getSystemMemoryInfo } from "./commands";
import { App } from "./app";
import "./styles.css";

configureListMemoryProvider(() => client(getSystemMemoryInfo, null));
const queryClient = createInstantQueryClient();
const root = document.getElementById("root");
if (!root) throw new Error("Missing application root");
createRoot(root).render(
  <StrictMode>
    <QueryClientProvider client={queryClient}>
      <App />
    </QueryClientProvider>
  </StrictMode>,
);
