{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "__NAME__",
  "version": "0.1.0",
  "identifier": "__IDENTIFIER__",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:__PORT__",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [{ "label": "main", "title": "__NAME__", "width": 1000, "height": 700 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:__PORT__ ws://127.0.0.1:__PORT__"
    }
  },
  "bundle": { "active": false }
}
